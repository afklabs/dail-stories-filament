APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:qq1TqszGT5KLX+K5Wh+1nu5HVzkIywRD09xZpFLNmk4=
APP_DEBUG=true
APP_URL=http://qesasy.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12


# File storage configuration
FILESYSTEM_DISK=local

# Rate limiting configuration
THROTTLE_REQUESTS_PER_MINUTE=60

# Security settings
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=43200



LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=admin_panel_filament
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OCTANE_SERVER=roadrunner

# Enable ALL Telescope Watchers
TELESCOPE_ENABLED=true

# Core Watchers
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_LOG_WATCHER=true

# Model & Database
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_REDIS_WATCHER=true

# Background Processing
TELESCOPE_JOB_WATCHER=true
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true

# Communication
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true

# Security
TELESCOPE_GATE_WATCHER=true

# External & Frontend
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_VIEW_WATCHER=true

# Development Tools
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_EVENT_WATCHER=true

# Sensitivity Settings (for maximum debugging)
TELESCOPE_LOG_LEVEL=debug
TELESCOPE_SLOW_QUERY_THRESHOLD=10
TELESCOPE_RESPONSE_SIZE_LIMIT=128
TELESCOPE_DUMP_WATCHER_ALWAYS=true


# PHPStan Analysis
#PHPSTAN_MEMORY_LIMIT=10G
PHPSTAN_LEVEL=6
